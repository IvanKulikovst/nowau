# ============================================================
# «Профиль кредитора» — конфигурация. Скопируйте в .env.
# Версия 1.0 → 2.0 отличается ТОЛЬКО значениями этих переменных.
# ============================================================

# --- Режим ---------------------------------------------------
PUBLIC_MODE=false          # true — публичный доступ (v2.0)
ENVIRONMENT=local          # local | prod. При local схема БД создаётся автоматически; в prod — alembic upgrade head

# --- Доступ --------------------------------------------------
PUBLIC_SIGNUP=false        # true — открыть /api/v1/auth/register
BILLING_ENABLED=false      # true — включить тарифы; false — всем tier="admin", /pricing показывает «Оплата скоро»
EMAIL_SENDING=false        # true — реально отправлять письма (нужен EMAIL_PROVIDER=smtp)
SSL_ENABLED=false          # true — HTTPS (nginx + certbot, см. README)

# --- Функции -------------------------------------------------
ANALYTICS_ENABLED=true     # внутренняя аналитика (таблица events)
METRICS_ENABLED=true       # Prometheus /metrics
RATE_LIMITING_ENABLED=true # лимит 100 запросов/мин на IP
RATE_LIMIT_PER_MINUTE=100
CIRCUIT_BREAKER_ENABLED=true
SHOW_COOKIE_BANNER=false   # показывать cookie-баннер (v2.0)

# --- Внешние сервисы -----------------------------------------
PARSERS_MODE=mock          # mock — демо-данные без сети; live — реальные ЕФРСБ и КАД Арбитр
EFRSB_API_URL=https://fedresurs.ru/api/v1
EFRSB_API_KEY=
KAD_BASE_URL=https://kad.arbitr.ru
PAYMENT_PROVIDER=mock      # mock | yookassa
EMAIL_PROVIDER=mock        # mock | smtp
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=

# --- База данных и кэш ---------------------------------------
POSTGRES_PASSWORD=postgres # пароль PostgreSQL (docker-compose); в prod задайте свой
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/creditor
REDIS_URL=redis://redis:6379/0

# --- Файлы ---------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=20

# --- Безопасность --------------------------------------------
SECRET_KEY=change-me-in-production     # python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=admin                    # пароль admin@local при первом создании; в v2.0 задайте свой
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Публичный доступ (v2.0) ---------------------------------
DOMAIN=localhost

# --- Celery --------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=true          # v1.0: фоновые задачи выполняются синхронно
